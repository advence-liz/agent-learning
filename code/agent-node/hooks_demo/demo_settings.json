{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "node hooks_demo/guard_bash.ts" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "node hooks_demo/stop_gate.ts" }]
      }
    ],
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "echo '本仓库：先跑 npm test 再交付'" }]
      }
    ]
  }
}
