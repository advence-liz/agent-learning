{
  // Node 24 直接跑 .ts（类型剥离），tsc 只做类型检查不产出文件。
  // erasableSyntaxOnly：禁用 enum / namespace / 参数属性这类剥离不掉的语法。
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": false,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
