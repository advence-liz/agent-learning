# 依赖环境：uv sync 可重建
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# 网页版：build 是构建产物，docs/ 是 tools/build_site.py 生成的软链接（绝对路径，换机器就失效）
.site/build/
.site/docs/

# 原站抓取内容（作者的免费文章全文），只供本地参考，不进仓库
.crawl/

# 运行时产物
# 抓包代理的输出（默认写到运行目录下的 captures/），已脱敏也不进仓库
captures/
*.log
.DS_Store

# 模型权重与数据缓存（体积大，脚本会重新下载 / 生成）
*.safetensors
*.bin
*.gguf
*.pt
*.ckpt
